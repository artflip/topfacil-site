layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/blog/' | absolute_url | xml_escape }}</loc></url>
  {% for post in site.posts %}{% unless post.published == false %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
  {% endunless %}{% endfor %}
</urlset>
